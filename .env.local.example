# Supabase — copy to .env.local and fill in from your project dashboard:

# https://supabase.com/dashboard/project/_/settings/api



NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key



# Server-only — required for Stripe webhooks and purchase fulfillment

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key



# Database read phase: 1 = Supabase writes + localStorage fallback reads

# 2 = Supabase only (recommended for production / Stripe)

NEXT_PUBLIC_DB_READ_PHASE=2



# App URL — used for invite links and Stripe redirect URLs
# Production: https://www.squareboards.pro

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production URL for npm run marketplace:sync and npm run pickem:sync (cron triggers)
PRODUCTION_APP_URL=https://www.squareboards.pro

# Supabase Auth (Dashboard → Authentication → URL Configuration)
# Site URL: https://www.squareboards.pro
# Redirect URLs (add both):
#   https://www.squareboards.pro/auth/callback
#   http://localhost:3000/auth/callback
#
# Or run: npm run supabase:configure-auth
# (requires SUPABASE_ACCESS_TOKEN from https://supabase.com/dashboard/account/tokens)

# WebAuthn / biometric login (production)
# WEBAUTHN_RP_ID=squareboards.pro
# WEBAUTHN_ORIGIN=https://www.squareboards.pro

# SUPABASE_ACCESS_TOKEN=sbp_...



# Marketplace mode (default on). Set to false to hide marketplace-first UX.

NEXT_PUBLIC_MARKETPLACE_MODE=true



# Cron secret — protects POST /api/cron/marketplace-sync

CRON_SECRET=your-random-cron-secret

# Web Push (ESPN-style device notifications via PWA)
# Generate: npm run push:generate-vapid
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@squareboards.pro

# Staff portal — comma-separated emails allowed to sign in at /admin/login
# Must match a Supabase Auth user (create with: npm run admin:create-user)
NEXT_PUBLIC_ADMIN_EMAILS=you@example.com

# Stripe Checkout

STRIPE_SECRET_KEY=sk_test_...mk_1Q02fvPrQEBdfRcs7V1amLgQ

# Stripe Connect — automatic winner payouts (Express or Accounts v2 recipient + transfers)

STRIPE_CONNECT_ENABLED=false

# Use Accounts v2 recipient onboarding for winner payouts (requires stripe@latest + v2 enabled in Stripe)
STRIPE_CONNECT_V2_PAYOUTS=false

# Stripe Connect Sample (Accounts v2 demo at /connect-sample)
# STRIPE_CONNECT_SAMPLE_THIN_WEBHOOK_SECRET=whsec_...
# STRIPE_CONNECT_SAMPLE_SUBSCRIPTION_PRICE_ID=price_...
# STRIPE_CONNECT_SAMPLE_APP_FEE_CENTS=123


RESEND_API_KEY=re_...

RESEND_FROM_EMAIL=SquareBoards <noreply@squareboards.pro>

# Optional: Porkbun DNS automation for Resend domain verification

# PORKBUN_API_KEY=pk1_...

# PORKBUN_SECRET_KEY=sk1_...



# Twilio — optional, SMS hook ready for later enablement

# TWILIO_ACCOUNT_SID=

# TWILIO_AUTH_TOKEN=

# TWILIO_FROM_NUMBER=


