# Supabase — copy to .env.local and fill in from your project dashboard:
# https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only — required for Stripe webhooks and purchase fulfillment
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database read phase: 1 = Supabase writes + localStorage fallback reads
# 2 = Supabase only (recommended for production / Stripe)
NEXT_PUBLIC_DB_READ_PHASE=2

# App URL — used for invite links and Stripe redirect URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe Checkout
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend — automatic invite emails after purchase
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Sports Squares <invites@yourdomain.com>

# Twilio — optional, SMS hook ready for later enablement
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
